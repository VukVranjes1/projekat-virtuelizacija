<?xml version="1.0" encoding="utf-8" ?>
<configuration>

  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>

  <!--
    Pragovi alarma se koriste tek u KT2 (zadatak 8/9/10), ali ih držimo
    u app.config od početka kako bismo ih centralno menjali.
  -->
  <appSettings>
    <add key="BvpSpikeThreshold" value="500" />
    <add key="SkinTempMinC" value="20" />
    <add key="SkinTempMaxC" value="45" />
    <add key="AccMotionThreshold" value="2.0" />
  </appSettings>

  <system.serviceModel>

    <bindings>
      <netTcpBinding>
        <!--
          Veliki MaxReceivedMessageSize i readerQuotas po zahtevu KT1 zadatka 3.

          Napomena (SR): TransferMode="Streamed" bi prisilio sve operacije da
          imaju jedan Stream/byte[] parametar, što je nekompatibilno sa našim
          DataContract-baziranim PushSample(E4Sample). Zato koristimo Buffered
          + velike kvote, a sekvencijalni streaming uzoraka radi se na nivou
          aplikacije (jedan PushSample poziv = jedan red CSV-a).
        -->
        <binding name="StreamingTcp"
                 transferMode="Buffered"
                 maxReceivedMessageSize="2147483647"
                 maxBufferSize="2147483647"
                 maxBufferPoolSize="2147483647"
                 sendTimeout="00:10:00"
                 receiveTimeout="00:10:00"
                 openTimeout="00:01:00"
                 closeTimeout="00:01:00">
          <readerQuotas maxDepth="64"
                        maxStringContentLength="2147483647"
                        maxArrayLength="2147483647"
                        maxBytesPerRead="2147483647"
                        maxNameTableCharCount="16384" />
          <!-- Bez sigurnosti za lokalni razvoj; u produkciji bi se uključio Transport. -->
          <security mode="None" />
        </binding>
      </netTcpBinding>
    </bindings>

    <services>
      <service name="GalaxyPPG.Server.GalaxyPpgService">
        <host>
          <baseAddresses>
            <add baseAddress="net.tcp://localhost:9000/GalaxyPPG" />
          </baseAddresses>
        </host>

        <!-- Glavni endpoint - DataContract komunikacija. -->
        <endpoint address=""
                  binding="netTcpBinding"
                  bindingConfiguration="StreamingTcp"
                  contract="GalaxyPPG.Common.IGalaxyPpgService" />

        <!-- MEX endpoint - olakšava generisanje proxy-ja iz Visual Studio-a. -->
        <endpoint address="mex"
                  binding="mexTcpBinding"
                  contract="IMetadataExchange" />
      </service>
    </services>

    <behaviors>
      <serviceBehaviors>
        <behavior>
          <serviceMetadata />
          <!-- includeExceptionDetailInFaults=true samo za razvoj. -->
          <serviceDebug includeExceptionDetailInFaults="true" />
          <serviceThrottling maxConcurrentCalls="200"
                             maxConcurrentSessions="100"
                             maxConcurrentInstances="200" />
        </behavior>
      </serviceBehaviors>
    </behaviors>

  </system.serviceModel>

</configuration>
