<?xml version="1.0" encoding="utf-8" ?>
<configuration>

  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>

  <appSettings>
    <!--
      Apsolutna putanja do GalaxyPPG/Dataset/. SDK-style net48 build izlazi u
      bin\Debug\net48\, što ima jedan nivo više od klasičnog bin\Debug\ pa
      relativna putanja "..\..\..\Dataset" ne radi - apsolutna je sigurnija.
    -->
    <add key="DatasetRoot" value="C:\Users\Vuk\Desktop\Projekat Virtuelizacija\GalaxyPPG\Dataset" />

    <!-- Sigurnosna granica za demo - klijent neće poslati više od ovoliko
         uzoraka po sesiji bez obzira što BVP.csv može imati 236k redova. -->
    <add key="MaxRowsPerSession" value="5000" />

    <!-- Putanje izlaznih dijagnostičkih fajlova - relativne na working dir. -->
    <add key="RejectedClientPath" value="rejected_client.csv" />
    <add key="LatencyLogPath" value="latency_client.csv" />
  </appSettings>

  <system.serviceModel>

    <bindings>
      <netTcpBinding>
        <binding name="StreamingTcp"
                 transferMode="Buffered"
                 maxReceivedMessageSize="2147483647"
                 maxBufferSize="2147483647"
                 maxBufferPoolSize="2147483647"
                 sendTimeout="00:10:00"
                 receiveTimeout="00:10:00">
          <readerQuotas maxDepth="64"
                        maxStringContentLength="2147483647"
                        maxArrayLength="2147483647"
                        maxBytesPerRead="2147483647"
                        maxNameTableCharCount="16384" />
          <security mode="None" />
        </binding>
      </netTcpBinding>
    </bindings>

    <client>
      <endpoint name="GalaxyPPGClient"
                address="net.tcp://localhost:9000/GalaxyPPG"
                binding="netTcpBinding"
                bindingConfiguration="StreamingTcp"
                contract="GalaxyPPG.Common.IGalaxyPpgService" />
    </client>

  </system.serviceModel>

</configuration>
